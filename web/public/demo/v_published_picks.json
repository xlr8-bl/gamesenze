 {"id":"25fdf4c8-1021-4245-9c39-c453fd38d945","fixture_id":"bb81ede6-d2d8-4de1-b9b7-fac6cdd6c551","market":"Match result","selection":"Real Madrid","confidence_tag":"best_bet","stakes_tags":["home_form","rest_advantage"],"internal_prob":0.47400,"capture_odds":2.300,"capture_bookmaker":"Pinnacle","closing_odds":null,"reasoning_full":"Take Madrid at a price that has drifted further than the case against them justifies. Two weeks into the season we are still weighting last term's underlying numbers heavily, and they read the same as the early returns: 2.4 expected goals a game at the Bernabeu and a back line that concedes clear chances rarely. City arrive on the road, where their press eases off and the expected goals they give up climbs toward 1.6. The line has slipped from 2.10 to 2.30 on the team news, and our number has not followed it down. That gap is the pick.","valid_factors":["xg_form","defensive_pressure","home_form","prior_season"],"excluded_factors":[{"n": 6, "factor": "referee_tendency", "message": "Referee tendency excluded: 6 matches at this level, below the 20-match minimum. This pick does not use it.", "minimum": 20, "disposition": "excluded"}],"published_at":"2026-08-22T03:44:57.426489+00:00","result":null,"sport":"football","kickoff_at":"2026-08-22T07:36:27.417845+00:00","fixture_status":"scheduled","competition":"UEFA Champions League","competition_country":"Europe","home_team":"Real Madrid","away_team":"Manchester City","latest_odds":2.170,"latest_bookmaker":"Pinnacle","latest_odds_at":"2026-08-22T06:35:57.431557+00:00"}, 
 {"id":"97370271-53eb-42ad-9867-897de39217a8","fixture_id":"eb25dc69-5fbc-4636-a673-6107297a3579","market":"Total goals","selection":"Over 2.5","confidence_tag":"strong_lean","stakes_tags":["pace","both_press"],"internal_prob":0.61800,"capture_odds":1.800,"capture_bookmaker":"Betfair","closing_odds":null,"reasoning_full":"Both these sides are built to trade blows, and the goals should follow. Bayern and Liverpool press high and bleed chances in transition in equal measure, and the combined expected goals in this fixture has cleared two and a half in five of the last six meetings. Neither back line has looked settled in the opening weeks, which only widens the range of a high-scoring night.","valid_factors":["xg_form","pace","both_press"],"excluded_factors":[{"n": 8, "factor": "player_variance", "message": "Striker finishing variance is provisional: 8 qualifying appearances against a 10-match minimum. It is weighted down rather than dropped.", "minimum": 10, "disposition": "provisional"}],"published_at":"2026-08-22T03:44:57.426489+00:00","result":null,"sport":"football","kickoff_at":"2026-08-22T09:54:27.417845+00:00","fixture_status":"scheduled","competition":"UEFA Champions League","competition_country":"Europe","home_team":"Bayern Munich","away_team":"Liverpool","latest_odds":1.700,"latest_bookmaker":"Betfair","latest_odds_at":"2026-08-22T06:35:57.431557+00:00"}, 
