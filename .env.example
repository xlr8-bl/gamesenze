# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:<pw>@db.<project>.supabase.co:5432/postgres

# --- Vendor APIs ------------------------------------------------------------
API_FOOTBALL_KEY=
# Kept registered but not used for live odds — its free tier only covers MLS
# and the Champions League for soccer. See ODDS_API_KEY below.
SPORTSGAMEODDS_KEY=
# football-data.org: free-tier current-season fixtures for 9 of our 17
# competitions (API-Football's free tier only reaches 2022-2024).
FOOTBALL_DATA_KEY=
# the-odds-api.com: the live odds source. Free tier covers the top-5
# European leagues plus Eredivisie/Primeira Liga/Championship — see
# docs/SETUP.md section 3 and gamesenze/providers/odds_api.py.
ODDS_API_KEY=
# Open-Meteo needs no key.

# --- Scraping (REQ-SCRAPE-2: identify honestly) -----------------------------
SCRAPER_CONTACT=ops@example.com

# --- GitHub Actions fallback for Cloudflare Workers -------------------------
GH_DISPATCH_TOKEN=
GH_REPO=xlr8-bl/gamesenze

# --- Alerting ---------------------------------------------------------------
ALERT_WEBHOOK_URL=
